# NotePilot Serverless Backend Environment Configuration
# Copy this file to backend/.dev.vars for local development with `wrangler dev`
# For production Cloudflare Workers deployment, set secrets using:
#   npx wrangler secret put FIREBASE_API_KEY
#   npx wrangler secret put GOOGLE_DRIVE_CLIENT_ID

# [REQUIRED SECRET] Firebase Web API Key (Kept strictly on Cloudflare Workers; NEVER exposed in frontend)
FIREBASE_API_KEY=AIzaSy_YOUR_FIREBASE_API_KEY_HERE

# [REQUIRED] Firebase Project ID
FIREBASE_PROJECT_ID=notepilot-8ebf4

# [REQUIRED] Allowed CORS Origins (comma-separated, include your GitHub Pages origin and local dev ports)
ALLOWED_ORIGIN=https://hannsraaz.github.io,http://localhost:5500,http://127.0.0.1:5500,http://localhost:3000,http://localhost:8787

# [OPTIONAL] Google Drive OAuth 2.0 Web Client ID for PDF Uploads
GOOGLE_DRIVE_CLIENT_ID=YOUR_GOOGLE_DRIVE_CLIENT_ID.apps.googleusercontent.com

# [OPTIONAL] Application Branding & Defaults
APP_NAME=NotePilot
SUPPORT_EMAIL=support@example.com
DEFAULT_THEME=dark

# [FRONTEND] NotePilot Backend URL (used when deploying frontend to GitHub Pages)
# Example: https://note-pilot-api.<your-subdomain>.workers.dev
NOTE_PILOT_API_URL=https://note-pilot-api.YOUR-SUBDOMAIN.workers.dev
